{
  "name": "purplefoxxx-site",
  "version": "1.0.0",
  "private": true,
  "description": "PurpleFoxxx portfolio site — 11ty + Tailwind CSS, deployed to Vercel.",
  "scripts": {
    "css:build": "tailwindcss -i ./src/assets/css/main.css -o ./src/assets/css/tailwind.css --minify",
    "css:watch": "tailwindcss -i ./src/assets/css/main.css -o ./src/assets/css/tailwind.css --watch",
    "eleventy:build": "eleventy",
    "eleventy:watch": "eleventy --serve",
    "build": "npm run css:build && npm run eleventy:build",
    "dev": "npm-run-all --parallel css:watch eleventy:watch",
    "clean": "rimraf _site src/assets/css/tailwind.css"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.0.0",
    "autoprefixer": "^10.4.20",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.4.47",
    "rimraf": "^6.0.1",
    "tailwindcss": "^3.4.13"
  }
}
