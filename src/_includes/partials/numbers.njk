<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-10 md:gap-12">
  {% for s in stats %}
    <div class="flex flex-col justify-between" data-reveal="up">
      <p class="font-mono text-label uppercase text-muted">
        0{{ loop.index }} / {{ s.label }}
      </p>
      <p
        class="mt-4 font-display text-display leading-none"
        data-count="{{ s.num }}"
        data-plain="{{ s.plain }}"
      >
        {{ s.num }}
      </p>
      <div class="my-5 h-0.5 bg-fg rule-draw"></div>
      <p class="text-sm text-muted leading-relaxed">
        {{ s.desc }}
      </p>
    </div>
  {% endfor %}
</div>
